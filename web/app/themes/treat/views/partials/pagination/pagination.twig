{% if pagination.pages|length > 1 %}
  <nav class="pagination" aria-label="Pagination">
    {% if pagination.prev %}<a href="{{ pagination.prev.link }}">Previous</a>{% endif %}
    {% for page in pagination.pages %}
      {% if page.link %}<a href="{{ page.link }}">{{ page.title }}</a>{% else %}<span aria-current="page">{{ page.title }}</span>{% endif %}
    {% endfor %}
    {% if pagination.next %}<a href="{{ pagination.next.link }}">Next</a>{% endif %}
  </nav>
{% endif %}
